# The address this computer publishes the worker on (its Tailscale or LAN address, never 0.0.0.0).
LISTEN_IP=
# Immich, as this computer reaches it, and an API key with asset read permission.
IMMICH_URL=
IMMICH_API_KEY=
# Shared with the laptop's ~/.config/lightcraft/... token file (at least 16 characters): openssl rand -hex 24
LIGHTCRAFT_PREVIEW_TOKEN=
